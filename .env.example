# Single environment file for the whole project: Postgres, backend, frontend.
#   - `cargo run` / `cargo test` / `sea-orm-cli` read it from the repo root.
#   - `frontend/` reads it too (Vite `envDir` points one level up).
#   - docker compose reads it for ${VAR} substitution and hands it to the
#     backend container; addresses that differ inside the compose network
#     (db:5432, backend:3000) are overridden inline in docker-compose.yml.
#
# Values below are for running things directly on your machine.

# --- Postgres -----------------------------------------------------------------
# Credentials are defined once here and substituted into DATABASE_URL and the
# compose `db` service.
POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp
POSTGRES_DB=myapp

# --- Host ports published by docker compose -----------------------------------
# Chosen so the containers can coexist with a local `cargo run` (3000) and
# `npm run dev` (5173).
POSTGRES_HOST_PORT=5434
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=8080
# The exact URL users open the compose-hosted frontend at. SvelteKit rejects
# form posts from any other origin, and the backend uses it for CORS. Must
# match FRONTEND_HOST_PORT and, in production, your public domain.
FRONTEND_ORIGIN=http://127.0.0.1:8080

# --- Backend ------------------------------------------------------------------
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
BIND_ADDR=127.0.0.1:3000
# Comma-separated origins allowed by CORS (the SvelteKit dev server by default)
CORS_ORIGINS=http://localhost:5173
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to true when served over HTTPS. Applies to the backend cookie and the
# frontend's re-issued cookie; browsers drop Secure cookies on plain http.
COOKIE_SECURE=false
RUST_LOG=info,myapp_server=debug,sqlx=warn

# --- Frontend -----------------------------------------------------------------
# Backend base URL as seen from the SvelteKit server (not the browser).
# Only variables prefixed with VITE_ are ever exposed to browser code.
API_URL=http://127.0.0.1:3000
