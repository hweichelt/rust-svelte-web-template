# Single environment file for the whole project: Postgres, backend, frontend.
#   - `cargo run` / `cargo test` / `sea-orm-cli` read it from the repo root.
#   - `frontend/` reads it too (Vite `envDir` points one level up).
#   - docker compose reads it for ${VAR} substitution and hands it to the
#     app container; the database address inside the compose network
#     (db:5432) is overridden inline in docker-compose.yml.
#
# Values below are for running things directly on your machine.

# --- Postgres -----------------------------------------------------------------
# Credentials are defined once here and substituted into DATABASE_URL and the
# compose `db` service.
POSTGRES_USER=myapp
POSTGRES_PASSWORD=myapp
POSTGRES_DB=myapp

# --- Host ports published by docker compose -----------------------------------
# Chosen so the containers can coexist with a local `cargo run` (3000) and
# the Vite dev server (5173).
POSTGRES_HOST_PORT=5434
APP_HOST_PORT=8080

# --- Backend ------------------------------------------------------------------
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
BIND_ADDR=127.0.0.1:3000
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to true when served over HTTPS; browsers drop Secure cookies on plain http.
COOKIE_SECURE=false
RUST_LOG=info,myapp_server=debug,sqlx=warn

# --- Frontend (development only) ----------------------------------------------
# Release builds embed the built app and ignore these.
# Port the Vite dev server listens on; the backend proxies page requests to it.
VITE_PORT=5173
# Let `cargo run` start `npm run dev` itself. Set to false to run Vite yourself.
VITE_AUTO_START=true
# Where the SvelteKit project lives, relative to where the backend is started.
FRONTEND_DIR=frontend
